# Copiar a .env y rellenar. El archivo .env esta en .gitignore.

# Cadena de conexion de PostgreSQL (Supabase > Project Settings > Database).
# Usar el "Connection pooling" (puerto 6543) o la conexion directa (5432).
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/postgres

# Puerto local del API. Si se omite, usa 3000.
PORT=3000

# --- Autenticación (Supabase Auth) ---
# Supabase > Project Settings > API.
# La service_role es secreta: solo backend, jamás en el frontend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canal de envío del código de restablecimiento: consola | sms | correo.
# Por defecto 'consola' (lo imprime en el log del servidor).
CANAL_CODIGO=consola